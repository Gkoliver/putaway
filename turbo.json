{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["TEST_DATABASE_URL", "BETTER_AUTH_SECRET"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {}
  }
}
