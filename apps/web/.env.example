DATABASE_URL=postgresql://putaway:putaway@localhost:5432/putaway

# Separate database for Vitest; withTestDb truncates app tables after each test.
# Create once: createdb -U putaway putaway_test
TEST_DATABASE_URL=postgresql://putaway:putaway@localhost:5432/putaway_test

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
